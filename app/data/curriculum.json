  "lessons": [
    {
      "group": "vowel",
      "slug": "i",
      "symbol": "i",
      "name": "高い前舌母音",
      "examples": [
        {
          "word": "see",
          "ipa": "si"
        },
        {
          "word": "seat",
          "ipa": "sit"
        }
      ],
      "features": [
        "舌：前・高い",
        "唇：丸めない",
        "比較的緊張した母音"
      ],
      "steps": [
        "舌の前側を上あごに近づける。",
        "唇を軽く横に広げ、息を止めず声を出す。"
      ],
      "tip": "長さだけで /ɪ/ と区別せず、舌の高さと音色を確かめます。",
      "comparison": "ih",
      "aliases": "iː",
      "structure": {
        "height": "high",
        "backness": "front",
        "rounding": "unrounded",
        "tenseness": "tense"
      }
    },
    {
      "group": "vowel",
      "slug": "ih",
      "symbol": "ɪ",
      "name": "やや低めの高い前舌母音",
      "examples": [
        {
          "word": "sit",
          "ipa": "sɪt"
        },
        {
          "word": "fish",
          "ipa": "fɪʃ"
        }
      ],
      "features": [
        "舌：前寄り・やや高い",
        "唇：丸めない",
        "弛緩母音"
      ],
      "steps": [
        " /i/ より舌を少し下げ、中央に寄せる。",
        "口の力を抜いて声を出す。"
      ],
      "tip": "日本語の「イ」を短くするだけにならないようにします。",
      "comparison": "i",
      "aliases": "",
      "structure": {
        "height": "near-high",
        "backness": "near-front",
        "rounding": "unrounded",
        "tenseness": "lax"
      }
    },
    {
      "group": "vowel",
      "slug": "eh",
      "symbol": "ɛ",
      "name": "中低の前舌母音",
      "examples": [
        {
          "word": "bed",
          "ipa": "bɛd"
        },
        {
          "word": "head",
          "ipa": "hɛd"
        }
      ],
      "features": [
        "舌：前・中低",
        "唇：丸めない",
        "弛緩母音"
      ],
      "steps": [
        "舌を前に置き、/ɪ/ より口を開く。",
        "唇を丸めず、舌の位置を保って声を出す。"
      ],
      "tip": " /æ/ ほどあごを下げません。辞書では /e/ と書く場合もあります。",
      "comparison": "ae",
      "aliases": "e（辞書による）",
      "structure": {
        "height": "open-mid",
        "backness": "front",
        "rounding": "unrounded",
        "tenseness": "lax"
      }
    },
    {
      "group": "vowel",
      "slug": "ae",
      "symbol": "æ",
      "name": "低い前舌母音",
      "examples": [
        {
          "word": "cat",
          "ipa": "kæt"
        },
        {
          "word": "cap",
          "ipa": "kæp"
        }
      ],
      "features": [
        "舌：前・低い",
        "唇：丸めない",
        "大きめの開口"
      ],
      "steps": [
        "舌を前方の低い位置に置く。",
        "あごを下げ、唇を丸めず声を出す。"
      ],
      "tip": " /ʌ/ より舌を前に置きます。鼻音の前などでは音色が変わることがあります。",
      "comparison": "uh",
      "aliases": "",
      "structure": {
        "height": "low",
        "backness": "front",
        "rounding": "unrounded",
        "tenseness": "lax"
      }
    },
    {
      "group": "vowel",
      "slug": "ah",
      "symbol": "ɑ",
      "name": "低い後舌母音",
      "examples": [
        {
          "word": "hot",
          "ipa": "hɑt"
        },
        {
          "word": "father",
          "ipa": "ˈfɑðɚ"
        }
      ],
      "features": [
        "舌：後ろ・低い",
        "唇：丸めない",
        "大きい開口"
      ],
      "steps": [
        "あごを下げて口を大きく開く。",
        "舌を低く後ろ寄りに置き、唇を丸めず発音する。"
      ],
      "tip": " /æ/ と口の開きだけでなく、舌の前後も比べます。",
      "comparison": "ae",
      "aliases": "ɑː",
      "structure": {
        "height": "low",
        "backness": "back",
        "rounding": "unrounded",
        "tenseness": "unspecified"
      }
    },
    {
      "group": "vowel",
      "slug": "aw",
      "symbol": "ɔ",
      "name": "中低の後舌母音",
      "examples": [
        {
          "word": "thought",
          "ipa": "θɔt"
        },
        {
          "word": "law",
          "ipa": "lɔ"
        }
      ],
      "features": [
        "舌：後ろ・中低",
        "唇：丸める",
        "/ɑ/ との区別に地域差"
      ],
      "steps": [
        "舌を後ろ寄りに置く。",
        " /ɑ/ より少し口を狭め、唇を丸めて発音する。"
      ],
      "tip": "cot–caught merger のある話者は /ɑ/ と /ɔ/ を区別しません。どちらもアメリカ英語の発音です。",
      "comparison": "ah",
      "aliases": "ɔː",
      "structure": {
        "height": "open-mid",
        "backness": "back",
        "rounding": "rounded",
        "tenseness": "unspecified"
      }
    },
