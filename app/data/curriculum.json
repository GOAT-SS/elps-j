      "features": [
        "舌：後ろ寄り・やや高い",
        "唇：軽く丸める",
        "弛緩母音"
      ],
      "steps": [
        "舌を後ろ寄りに持ち上げる。",
        " /u/ より舌を下げ、唇の緊張を弱めて声を出す。"
      ],
      "tip": " /u/ を短くするだけでなく、口の力を抜いて音色を変えます。",
      "comparison": "u",
      "aliases": "",
      "structure": {
        "height": "near-high",
        "backness": "near-back",
        "rounding": "lightly-rounded",
        "tenseness": "lax"
      }
    },
    {
      "group": "vowel",
      "slug": "u",
      "symbol": "u",
      "name": "高い後舌母音",
      "examples": [
        {
          "word": "food",
          "ipa": "fud"
        },
        {
          "word": "blue",
          "ipa": "blu"
        }
      ],
      "features": [
        "舌：高い・後ろ寄り",
        "唇：丸める",
        "比較的緊張した母音"
      ],
      "steps": [
        "舌を高くし、唇を丸める。",
        "息を止めず、一定の声を出す。"
      ],
      "tip": "日本語の「ウ」より唇の丸めを意識します。アメリカ英語では舌が中央寄りになる話者もいます。",
      "comparison": "uu",
      "aliases": "uː",
      "structure": {
        "height": "high",
