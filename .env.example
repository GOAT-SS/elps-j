# Next.js Route Handler -> FastAPI
# Local: http://127.0.0.1:8000
# External: your named Cloudflare Tunnel URL
PRONUNCIATION_API_BASE_URL=http://127.0.0.1:8000

# Required by FastAPI and the Next.js proxy. Use the same long random value.
PRONUNCIATION_API_KEY=replace-with-a-long-random-value

# Optional: use these after protecting a named tunnel with Cloudflare Access.
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=
